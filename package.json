{
  "name": "kindred-plugin-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bench 插件市场 — 插件发布源与架构文档",
  "scripts": {
    "start": "node scripts/menu.mjs",
    "diagrams": "node docs/diagrams/server.mjs",
    "diagrams:select": "node docs/diagrams/launch.mjs",
    "hooks:install": "node scripts/quality/install-hooks.mjs",
    "check:precommit": "node node_modules/lefthook/bin/index.js run pre-commit",
    "check:md-links": "node scripts/quality/check-markdown-links.mjs --all",
    "prepare": "node scripts/quality/install-hooks.mjs",
    "audit:ext-i18n": "node scripts/audit-i18n.mjs",
    "check:i18n-parity": "node scripts/check-i18n-parity.mjs --market . --bench ../tauri-app",
    "check:i18n": "pnpm run audit:ext-i18n && pnpm run check:i18n-parity"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "lefthook": "^2.1.14",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "markdown-link-check": "^3"
  }
}
