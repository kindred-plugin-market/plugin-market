{
  "schemaVersion": 2,
  "id": "quick-launch",
  "version": "1.0.1",
  "display": {
    "zh": "快捷启动",
    "en": "Quick Launch"
  },
  "description": {
    "zh": "场景化应用启动网格：搜索、分类、拖拽排序、用户覆盖与虚拟化应用网格",
    "en": "Scenario-based app launcher grid: search, classify, drag-reorder, overrides & virtualized grid"
  },
  "distribution": "bundled",
  "entry": {
    "index": "index.html"
  },
  "acl": {
    "commands": [
      "scan_installed_apps",
      "cancel_app_inventory_scan",
      "get_cached_app_inventory",
      "get_app_icon_base64",
      "launch_app",
      "reveal_app_in_finder",
      "authorize_mac_app",
      "check_managed_app_updates",
      "upgrade_app",
      "uninstall_app",
      "batch_upgrade_apps",
      "batch_uninstall_apps",
      "install_app",
      "cancel_batch_operation",
      "check_all_app_updates",
      "open_in_mac_app_store",
      "open_in_mac_app_store_updates",
      "install_app_update",
      "cancel_app_update"
    ]
  },
  "engines": {
    "bench": ">=1.30.0"
  }
}
